// LUMEN App Store configuration.
// https:// in xcconfig must be written as https:/$()/ because // starts a comment.
// LUMEN_DEVELOPMENT_TEAM stays TODO_APPLE_TEAM_ID until Adam pastes the Apple Developer Team ID.
// App Store Connect contact email is the Apple ID email. It is not in this repo.
// TODO_APP_STORE_CONNECT_CONTACT_EMAIL

PRODUCT_BUNDLE_IDENTIFIER = com.adimego.lumen
MARKETING_VERSION = 26.0
CURRENT_PROJECT_VERSION = 26
LUMEN_DEVELOPMENT_TEAM = TODO_APPLE_TEAM_ID
LUMEN_PRIVACY_POLICY_URL = https:/$()/adimego.github.io/lumen-game/privacy.html
LUMEN_TERMS_URL = https:/$()/adimego.github.io/lumen-game/terms.html
LUMEN_SUPPORT_URL = https:/$()/adimego.github.io/lumen-game/support.html

IPHONEOS_DEPLOYMENT_TARGET = 16.0
TARGETED_DEVICE_FAMILY = 1,2
SDKROOT = iphoneos
SUPPORTED_PLATFORMS = iphoneos iphonesimulator
SWIFT_VERSION = 5.0
CODE_SIGN_STYLE = Automatic
DEVELOPMENT_TEAM =
CODE_SIGN_ENTITLEMENTS = Lumen/Lumen.entitlements
GENERATE_INFOPLIST_FILE = NO
INFOPLIST_FILE = Lumen/Info.plist
ENABLE_USER_SCRIPT_SANDBOXING = NO
ASSETCATALOG_COMPILER_APPICON_NAME = AppIcon
PRODUCT_NAME = Lumen
LD_RUNPATH_SEARCH_PATHS = $(inherited) @executable_path/Frameworks
CLANG_ENABLE_MODULES = YES
SWIFT_EMIT_LOC_STRINGS = YES
ENABLE_PREVIEWS = NO
